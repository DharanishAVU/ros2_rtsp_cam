# =============================================================================
# camera.env — single source of truth for all runtime container settings.
# Edit this file to change camera, RTSP, ROS2, or calibration behaviour.
# Then run:  docker compose up -d  (no rebuild needed)
# =============================================================================

# -----------------------------------------------------------------------------
# Camera source
# -----------------------------------------------------------------------------
DEVICE=/dev/video-front

# -----------------------------------------------------------------------------
# Capture resolution & framerate (what the camera hardware outputs as MJPEG)
# -----------------------------------------------------------------------------
WIDTH=1920
HEIGHT=1080
FRAMERATE=30

# MJPEG decode strategy: 1 = GPU (nvv4l2decoder, recommended on Jetson),
#                        0 = CPU fallback (jpegdec)
USE_HW_MJPEG_DECODER=1

# -----------------------------------------------------------------------------
# RTSP branch — H.264 stream at rtsp://localhost:8554/camera
# Downscaled from capture resolution to reduce network bandwidth.
# -----------------------------------------------------------------------------
RTSP_WIDTH=1280
RTSP_HEIGHT=720
RTSP_FRAMERATE=30

# -----------------------------------------------------------------------------
# ROS2 branch — /camera/image_raw (rgb8) + /camera/camera_info
# Keep at full resolution for maximum quality (e.g. ArUco detection).
# -----------------------------------------------------------------------------
ROS_WIDTH=1920
ROS_HEIGHT=1080
ROS_FRAMERATE=30

# 1 = publish RTSP + ROS2 topics (default)
# 0 = RTSP only (ROS2 publisher not started)
ROS2_ENABLED=1

# -----------------------------------------------------------------------------
# Camera calibration file
# Path INSIDE the container. The volume mount in docker-compose.yml maps
# ./camera_info.yaml (repo root) to this path — edit camera_info.yaml and
# run `docker compose up -d` to apply, no rebuild needed.
# -----------------------------------------------------------------------------
CAMERA_INFO_FILE=/etc/camera_info.yaml

# -----------------------------------------------------------------------------
# ROS2 DDS / CycloneDDS
# -----------------------------------------------------------------------------
ROS_DOMAIN_ID=82
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Loopback-only (both containers on same host)
CYCLONEDDS_URI=<CycloneDDS><Domain><General><Interfaces><NetworkInterface name="lo"/></Interfaces><MaxMessageSize>65500B</MaxMessageSize><FragmentSize>65000B</FragmentSize></General></Domain></CycloneDDS>

# Unicast peer variant — uncomment and set laptop IP to expose topics remotely:
# CYCLONEDDS_URI=<CycloneDDS><Domain><General><Interfaces><NetworkInterface autodetermine="true"/></Interfaces><MaxMessageSize>65500B</MaxMessageSize><FragmentSize>65000B</FragmentSize></General><Discovery><Peers><Peer address="192.168.1.52"/></Peers></Discovery></Domain></CycloneDDS>

# -----------------------------------------------------------------------------
# Diagnostics (rarely need changing)
# -----------------------------------------------------------------------------
GST_DEBUG=1
PYTHONFAULTHANDLER=1
